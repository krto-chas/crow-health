# Bind only to loopback by default. Set this to the Debian server LAN address when remote clients need access.
CROW_HEALTH_BIND_ADDRESS=127.0.0.1
CROW_HEALTH_PORT=8000

# Numeric host UID/GID used for writes to /srv/crow-data/health.
CROW_HEALTH_UID=1000
CROW_HEALTH_GID=1000

# Leave unset until Apple Health manifest intake is intentionally enabled.
CROW_HEALTH_APPLE_MANIFEST_TOKEN=
